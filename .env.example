# ============================================================
# MIL Business Snapshot — required environment variables
# Copy to .env.local for local dev, and set the SAME keys in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# .env.local is gitignored; never commit real values.
# ============================================================

# ── Supabase (REQUIRED) ─────────────────────────────────────
# Used by the browser client, the server client, and the auth middleware.
# Without these the app throws on every request (middleware runs on all routes).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret (NO NEXT_PUBLIC prefix — never exposed to the browser).
# Required by the admin "create user" server action
# (src/features/users/api/actions.ts). Set it in Vercel as a secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Sentry (OPTIONAL) ───────────────────────────────────────
# The build self-disables Sentry when org/project are unset, so these are
# NOT required to deploy. To turn error monitoring ON, set org + project + DSN.
# To skip Sentry entirely, set NEXT_PUBLIC_SENTRY_DISABLED=1.
# NEXT_PUBLIC_SENTRY_DISABLED=1
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ORG=
# NEXT_PUBLIC_SENTRY_PROJECT=

# ── Build (OPTIONAL) ────────────────────────────────────────
# Only set BUILD_STANDALONE=true for self-hosted/Docker standalone output.
# Leave UNSET on Vercel.
# BUILD_STANDALONE=true
